   "source": [
    "shape_summary = pd.DataFrame([\n",
    "    {\n",
    "        \"dataset\": name,\n",
    "        \"rows\": df.shape[0],\n",
    "        \"columns\": df.shape[1],\n",
    "    }\n",
    "    for name, df in datasets.items()\n",
    "])\n",
    "\n",
    "shape_summary\n"
