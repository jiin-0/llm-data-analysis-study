   "source": [
    "price_text = pd.Series([\"10,000\", \"25,500\", \"3000\", \"확인필요\"])\n",
    "price_number = pd.to_numeric(\n",
    "    price_text.str.replace(\",\", \"\", regex=False),\n",
    "    errors=\"coerce\",\n",
    ")\n",
    "\n",
    "pd.DataFrame({\n",
    "    \"original\": price_text,\n",
    "    \"converted\": price_number,\n",
    "})\n"
   ]
